{
  "advancedAlgebra": {
    "complexNumbers": {
      "title": "Complex Numbers",
      "description": "Numbers of the form \\(a + bi\\) where \\(i\\) is the imaginary unit (\\(i^2 = -1\\))",
      "concepts": [
        {
          "name": "Basic Operations",
          "explanation": "Complex numbers can be added, subtracted, multiplied, and divided like algebraic expressions.",
          "examples": [
            {
              "problem": "Add \\((3 + 2i) + (1 + 4i)\\)",
              "solution": "\\((3 + 1) + (2i + 4i) = 4 + 6i\\)",
              "steps": [
                "Add real parts: \\(3 + 1 = 4\\)",
                "Add imaginary parts: \\(2i + 4i = 6i\\)",
                "Result: \\(4 + 6i\\)"
              ]
            },
            {
              "problem": "Multiply \\((2 + 3i)(1 + 2i)\\)",
              "solution": "\\(2(1) + 2(2i) + 3i(1) + 3i(2i) = 2 + 4i + 3i + 6i^2 = 2 + 7i - 6 = -4 + 7i\\)",
              "steps": [
                "Use FOIL: First, Outer, Inner, Last",
                "\\(2 \\cdot 1 = 2\\)",
                "\\(2 \\cdot 2i = 4i\\)",
                "\\(3i \\cdot 1 = 3i\\)",
                "\\(3i \\cdot 2i = 6i^2 = -6\\) (since \\(i^2 = -1\\))",
                "Combine: \\(2 - 6 + 4i + 3i = -4 + 7i\\)"
              ]
            }
          ]
        },
        {
          "name": "Complex Conjugates",
          "explanation": "The conjugate of \\(a + bi\\) is \\(a - bi\\). Used to simplify division of complex numbers.",
          "examples": [
            {
              "problem": "Divide \\((3 + 2i) \\div (1 + i)\\)",
              "solution": "\\(\\dfrac{3 + 2i}{1 + i} \\times \\dfrac{1 - i}{1 - i} = \\dfrac{3 - 3i + 2i - 2i^2}{1 - i^2} = \\dfrac{5 - i}{2} = 2.5 - 0.5i\\)",
              "steps": [
                "Multiply numerator and denominator by the conjugate of the denominator",
                "Numerator: \\((3 + 2i)(1 - i) = 3 - 3i + 2i - 2i^2 = 3 - i + 2 = 5 - i\\)",
                "Denominator: \\((1 + i)(1 - i) = 1 - i^2 = 1 + 1 = 2\\)",
                "Result: \\(\\dfrac{5 - i}{2} = 2.5 - 0.5i\\)"
              ]
            }
          ]
        }
      ],
      "problemGenerator": {
        "types": [
          {
            "name": "add_complex",
            "description": "Add two complex numbers",
            "template": "Add ({a} + {b}i) + ({c} + {d}i)",
            "solution": "({a}+{c}) + ({b}+{d})i"
          },
          {
            "name": "multiply_complex",
            "description": "Multiply two complex numbers",
            "template": "Multiply ({a} + {b}i)({c} + {d}i)",
            "solution": "({a*c}-{b*d}) + ({a*d}+{b*c})i"
          },
          {
            "name": "conjugate_divide",
            "description": "Divide complex numbers using conjugates",
            "template": "Divide ({a} + {b}i) ÷ ({c} + {d}i)",
            "note": "Multiply by conjugate of denominator"
          }
        ]
      }
    },
    "polynomialOperations": {
      "title": "Polynomial Operations & Factoring",
      "description": "Operations involving polynomials of degree 2 or higher, and advanced factoring techniques",
      "concepts": [
        {
          "name": "Polynomial Division",
          "explanation": "Dividing polynomials using long division or synthetic division",
          "examples": [
            {
              "problem": "Divide \\((x^2 + 5x + 6) \\div (x + 2)\\)",
              "solution": "\\(x + 3\\)",
              "steps": [
                "Set up long division",
                "\\(x^2 \\div x = x\\). Multiply: \\(x(x + 2) = x^2 + 2x\\)",
                "Subtract: \\((x^2 + 5x + 6) - (x^2 + 2x) = 3x + 6\\)",
                "\\(3x \\div x = 3\\). Multiply: \\(3(x + 2) = 3x + 6\\)",
                "Subtract: \\((3x + 6) - (3x + 6) = 0\\)",
                "Quotient: \\(x + 3\\)"
              ]
            }
          ]
        },
        {
          "name": "Advanced Factoring",
          "explanation": "Factoring techniques including grouping, sum/difference of cubes, and trinomial factoring",
          "examples": [
            {
              "problem": "Factor \\(x^3 + 8\\)",
              "solution": "\\((x + 2)(x^2 - 2x + 4)\\)",
              "steps": [
                "Recognize as sum of cubes: \\(a^3 + b^3 = (a + b)(a^2 - ab + b^2)\\)",
                "\\(x^3 + 8 = x^3 + 2^3\\)",
                "\\(a = x, b = 2\\)",
                "\\((x + 2)(x^2 - 2x + 4)\\)"
              ]
            },
            {
              "problem": "Factor \\(x^3 - 27\\)",
              "solution": "\\((x - 3)(x^2 + 3x + 9)\\)",
              "steps": [
                "Recognize as difference of cubes: \\(a^3 - b^3 = (a - b)(a^2 + ab + b^2)\\)",
                "\\(x^3 - 27 = x^3 - 3^3\\)",
                "\\(a = x, b = 3\\)",
                "\\((x - 3)(x^2 + 3x + 9)\\)"
              ]
            }
          ]
        },
        {
          "name": "Remainder & Factor Theorems",
          "explanation": "When \\(p(x)\\) is divided by \\((x - a)\\), the remainder equals \\(p(a)\\). If the remainder is 0, then \\((x - a)\\) is a factor.",
          "examples": [
            {
              "problem": "Use the Remainder Theorem to find the remainder when \\(p(x) = x^3 - 2x^2 + x - 5\\) is divided by \\((x - 2)\\)",
              "solution": "Remainder = 1",
              "steps": [
                "By the Remainder Theorem, the remainder equals \\(p(2)\\)",
                "\\(p(2) = (2)^3 - 2(2)^2 + 2 - 5\\)",
                "\\(p(2) = 8 - 8 + 2 - 5 = -3\\)",
                "Remainder = -3"
              ]
            }
          ]
        }
      ],
      "problemGenerator": {
        "types": [
          {
            "name": "sum_of_cubes",
            "description": "Factor sum of cubes",
            "template": "Factor x³ + {n}",
            "note": "Use formula a³ + b³ = (a + b)(a² - ab + b²)"
          },
          {
            "name": "diff_of_cubes",
            "description": "Factor difference of cubes",
            "template": "Factor x³ - {n}",
            "note": "Use formula a³ - b³ = (a - b)(a² + ab + b²)"
          },
          {
            "name": "trinomial_factor",
            "description": "Factor trinomials",
            "template": "Factor x² + {b}x + {c}",
            "note": "Find two numbers that multiply to c and add to b"
          }
        ]
      }
    },
    "rationalExpressions": {
      "title": "Rational Expressions & Equations",
      "description": "Fractions with polynomials in numerator and denominator",
      "concepts": [
        {
          "name": "Simplifying Rational Expressions",
          "explanation": "Factor and cancel common factors from numerator and denominator",
          "examples": [
            {
              "problem": "Simplify \\(\\dfrac{x^2 - 4}{x^2 - 2x}\\)",
              "solution": "\\(\\dfrac{x + 2}{x}\\)",
              "steps": [
                "Factor numerator: \\(x^2 - 4 = (x + 2)(x - 2)\\)",
                "Factor denominator: \\(x^2 - 2x = x(x - 2)\\)",
                "Cancel the common factor \\((x - 2)\\): \\(\\dfrac{(x + 2)(x - 2)}{x(x - 2)} = \\dfrac{x + 2}{x}\\)",
                "Note: \\(x \\neq 0\\) and \\(x \\neq 2\\)"
              ]
            }
          ]
        },
        {
          "name": "Operations with Rational Expressions",
          "explanation": "Add, subtract, multiply, and divide rational expressions",
          "examples": [
            {
              "problem": "Add \\(\\dfrac{1}{x + 1} + \\dfrac{2}{x}\\)",
              "solution": "\\(\\dfrac{3x + 2}{x(x + 1)}\\)",
              "steps": [
                "Find the common denominator: \\(x(x + 1)\\)",
                "\\(\\dfrac{1}{x + 1} = \\dfrac{x}{x(x + 1)}\\)",
                "\\(\\dfrac{2}{x} = \\dfrac{2(x + 1)}{x(x + 1)}\\)",
                "Add: \\(\\dfrac{x}{x(x + 1)} + \\dfrac{2(x + 1)}{x(x + 1)} = \\dfrac{x + 2x + 2}{x(x + 1)} = \\dfrac{3x + 2}{x(x + 1)}\\)"
              ]
            }
          ]
        },
        {
          "name": "Solving Rational Equations",
          "explanation": "Equations containing rational expressions. Multiply by the LCD to clear denominators.",
          "examples": [
            {
              "problem": "Solve \\(\\dfrac{1}{x} + \\dfrac{1}{x + 1} = \\dfrac{1}{2}\\)",
              "solution": "x = -2 or x = 1",
              "steps": [
                "LCD \\(= 2x(x + 1)\\)",
                "Multiply all terms by \\(2x(x + 1)\\): \\(2(x + 1) + 2x = x(x + 1)\\)",
                "Expand: \\(2x + 2 + 2x = x^2 + x\\)",
                "Simplify: \\(4x + 2 = x^2 + x\\)",
                "Rearrange: \\(x^2 - 3x - 2 = 0\\)",
                "Use the quadratic formula: \\(x = \\dfrac{3 \\pm \\sqrt{9 + 8}}{2} = \\dfrac{3 \\pm \\sqrt{17}}{2}\\)"
              ]
            }
          ]
        }
      ],
      "problemGenerator": {
        "types": [
          {
            "name": "simplify_rational",
            "description": "Simplify rational expressions",
            "template": "Simplify ({n1}x² + {n2}x + {n3})/({d1}x² + {d2}x + {d3})",
            "note": "Factor numerator and denominator, then cancel"
          },
