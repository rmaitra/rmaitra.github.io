            "template": "Add {a1}/{a2} + {b1}/{b2}",
            "note": "Find LCD and combine"
          }
        ]
      }
    },
    "exponentialLogarithmic": {
      "title": "Exponential & Logarithmic Functions",
      "description": "Properties and solving equations involving exponentials and logarithms",
      "concepts": [
        {
          "name": "Exponential Functions",
          "explanation": "Functions of the form \\(f(x) = a \\cdot b^{cx+d}\\). Used for modeling growth and decay.",
          "examples": [
            {
              "problem": "Solve \\(2^x = 16\\)",
              "solution": "x = 4",
              "steps": [
                "Recognize \\(16 = 2^4\\)",
                "\\(2^x = 2^4\\)",
                "\\(x = 4\\)"
              ]
            },
            {
              "problem": "Solve \\(5^{2x} = 125\\)",
              "solution": "x = 1.5",
              "steps": [
                "Recognize \\(125 = 5^3\\)",
                "\\(5^{2x} = 5^3\\)",
                "\\(2x = 3\\)",
                "\\(x = 1.5\\)"
              ]
            }
          ]
        },
        {
          "name": "Logarithmic Functions",
          "explanation": "The inverse of exponential functions. \\(\\log_b(x) = y\\) means \\(b^y = x\\)",
          "examples": [
            {
              "problem": "Solve \\(\\log_2(x) = 5\\)",
              "solution": "x = 32",
              "steps": [
                "Convert to exponential form: \\(2^5 = x\\)",
                "\\(x = 32\\)"
              ]
            },
            {
              "problem": "Solve \\(\\log_3(x - 1) = 2\\)",
              "solution": "x = 10",
              "steps": [
                "Convert to exponential form: \\(3^2 = x - 1\\)",
                "\\(9 = x - 1\\)",
                "\\(x = 10\\)"
              ]
            }
          ]
        },
        {
          "name": "Logarithm Properties",
          "explanation": "Properties: \\(\\log(ab) = \\log(a) + \\log(b)\\), \\(\\log(a/b) = \\log(a) - \\log(b)\\), \\(\\log(a^n) = n \\cdot \\log(a)\\)",
          "examples": [
            {
              "problem": "Solve \\(\\log(x) + \\log(x - 3) = 1\\)",
              "solution": "x = 5",
              "steps": [
                "Use the property \\(\\log(a) + \\log(b) = \\log(ab)\\): \\(\\log(x(x-3)) = 1\\)",
                "Convert to exponential form: \\(10^1 = x(x - 3)\\)",
                "\\(10 = x^2 - 3x\\)",
                "\\(x^2 - 3x - 10 = 0\\)",
                "Factor: \\((x - 5)(x + 2) = 0\\)",
                "\\(x = 5\\) (\\(x = -2\\) is invalid since log requires a positive argument)"
              ]
            }
          ]
        }
      ],
      "problemGenerator": {
        "types": [
          {
            "name": "solve_exponential",
            "description": "Solve exponential equations",
            "template": "{base}^x = {answer}",
            "note": "Rewrite base or use logarithms"
          },
          {
            "name": "solve_logarithm",
