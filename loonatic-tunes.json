                "timestamps": [
                    { "time": 0, "movement": "1. Earth", "label": "", "text": "Earth bubbles and cracks with lava and lightning. An earth left behind by the gods." },
                    { "time": 308, "movement": "2. Tangulizi", "label": "Part 1, Life in Chains", "text": "Msichana walks through her town. A town surrounded by rock walls, dust and chains." },
                    { "time": 461, "movement": "2. Tangulizi", "label": "Part 2, Joy Inside Walls", "text": "She finds her family and the town rejoices together as night falls." },
                    { "time": 579, "movement": "3. Imani", "label": "Escape over the Wall and Into The Dark", "text": "Into the night, Msichana thinks of the world beyond their walls. She believes there is more than dust and chains. Driven by faith of something more, Msichana climbs over the wall and into a new world." },
                    { "time": 852, "movement": "4. Blossom", "label": "Part 1, Through Dark", "text": "Msichana wanders aimlessly through the wild." },
                    { "time": 1166, "movement": "4. Blossom", "label": "Part 2, Light off the Mountain", "text": "As dawn arrives, she sees an omen: light atop a mountain that reaches through the clouds." },
                    { "time": 1402, "movement": "5. Ubuntu", "label": "Up the Mountain", "text": "Msichana zigs and zags through rocks and brush. She scales ledges of stone and dust." },
                    { "time": 1656, "movement": "6. Uhuru", "label": "Part 1, Climbing to the Summit", "text": "Msichana summits the mountain of gods and watches them dance." },
                    { "time": 1915, "movement": "6. Uhuru", "label": "Part 2, Dance of Stars", "text": "Gods revel in excess." },
                    { "time": 2024, "movement": "6. Uhuru", "label": "Part 3, Msichana Dances with Gods", "text": "Msichana, in excitement, disguises herself and dances with the Gods." },
                    { "time": 2140, "movement": "6. Uhuru", "label": "Part 4, Judgement", "text": "As she dances, the Gods look upon her in awe of her dance. Enviously, a god pulls the disguise from Msichana. The Gods grimace in disgust of Msichana." },
                    { "time": 2266, "movement": "6. Uhuru", "label": "Part 5, Falling from Paradise", "text": "The Gods throw Msichana from paradise." },
                    { "time": 2401, "movement": "7. Respite", "label": "Spirits Call", "text": "Msichana awakes on the soil beside ice and water. She hears the calls of her people across the landscape and her spirit awakens." },
                    { "time": 2690, "movement": "8. Peace and Earth", "label": "", "text": "Msichana’s spirit fades." }
                ]
            }
